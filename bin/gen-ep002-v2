REFS[16]="$SHEET/CS-09-nasa-control.png $SHEET/CS-03-crew.png"

PAGES="${*:-01 02 03 04 05 06 07 08 09 10 11 12 13 14 15 16}"
echo "[$(date +%H:%M:%S)] EP002 v2 배치 시작 — 대상: $PAGES" >> "$LOG"
for NN in $PAGES; do
  PROMPT="만화 한 페이지 이미지를 생성해줘. $STYLE ${CUTS[$NN]} $TEXT"
  echo "$PROMPT" > "$PDIR/page-$NN.md"
  echo "[$(date +%H:%M:%S)] page-$NN 생성 시작" >> "$LOG"
  codex exec "$PROMPT" -c model=gpt-5.6-terra $(for r in ${REFS[$NN]}; do echo -n "-i $r "; done) >/dev/null 2>&1
  PNG=$(ls -t ~/.codex/generated_images/*/exec-*.png 2>/dev/null | head -1)
  if [ -n "$PNG" ]; then
    cp "$PNG" "$OUT/page-$NN.png"
    echo "[$(date +%H:%M:%S)] page-$NN 완료" >> "$LOG"
  else
    echo "[$(date +%H:%M:%S)] page-$NN 실패(이미지 없음)" >> "$LOG"
  fi
done
echo "[$(date +%H:%M:%S)] EP002 v2 배치 종료 — $PAGES" >> "$LOG"
